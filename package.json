{
	"name": "throwaway-worker",
	"version": "1.2.16",
	"description": "Detect disposable email domains via a bloom filter — Cloudflare Worker JSON API",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.0.0"
	},
	"author": "chris@sslboard.com",
	"license": "MIT",
	"scripts": {
		"build:filter": "tsx scripts/build-filter.ts",
		"build:agent-artifacts": "tsx scripts/build-agent-artifacts.ts",
		"build": "npm run build:filter && npm run build:agent-artifacts && tsc --noEmit",
		"dev": "wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.4",
		"@emnapi/core": "^1.11.2",
		"@emnapi/runtime": "^1.11.2",
		"@playwright/test": "^1.61.1",
		"prettier": "^3.9.5",
		"tsx": "^4.23.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"wrangler": "^4.110.0"
	},
	"dependencies": {
		"hono": "^4.12.28",
		"tldts": "^7.4.8"
	},
	"overrides": {
		"esbuild": "0.28.1"
	}
}
